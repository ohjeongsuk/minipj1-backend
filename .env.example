# Spring 이 .properties 문법으로 읽는다. 인라인 주석(#)은 값에 포함되므로 주석은 줄 단위로 쓴다.

DB_URL=jdbc:postgresql://localhost:5432/miniproject1_db
DB_URL_TEST=jdbc:postgresql://localhost:5432/miniproject1_test
DB_USERNAME=
DB_PASSWORD=

# raw UTF-8 32자 이상. Base64 로 두고 디코드하면 32자가 24바이트가 되어 WeakKeyException 이 난다.
JWT_SECRET=
JWT_EXPIRATION=86400000

CORS_ALLOWED_ORIGINS=http://localhost:3000

# 구글 로그인(AUTH-09). 비워 두면 기동은 되고 구글 로그인만 동작하지 않는다.
# Google Cloud Console 의 승인된 리디렉션 URI 는 백엔드 주소다 —
# http://localhost:8080/login/oauth2/code/google
# 프론트 주소를 넣으면 redirect_uri_mismatch 가 난다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 구글 인증 후 돌아갈 프론트 주소. 미지정 시 http://localhost:3000/oauth/callback
OAUTH2_REDIRECT_URI=
